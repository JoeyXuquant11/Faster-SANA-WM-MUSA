+
+    for (int s = s0; s < s1; ++s) {
+        int m = bt * S + s;
+        float v[8], sum = 0.0f, sum2 = 0.0f;
+        if (active) {
+            int64_t idx = static_cast<int64_t>(m) * C8 + tid;
+            uint4 xv = x4[idx];
+            if (b4 != nullptr) {
+                uint4 bv = b4[idx];
+                const __mt_bfloat162* xh = reinterpret_cast<const __mt_bfloat162*>(&xv);
+                const __mt_bfloat162* bh = reinterpret_cast<const __mt_bfloat162*>(&bv);
