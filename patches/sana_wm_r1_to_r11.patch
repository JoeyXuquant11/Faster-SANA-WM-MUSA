+def _stream(device) -> int:
+    return torch.musa.current_stream(device).musa_stream
+
+
+def _eye_cache(D: int, device, dtype):
+    key = (D, device, dtype)
+    t = _EYE_DICT.get(key)
+    if t is None:
+        t = torch.eye(D, device=device, dtype=dtype).unsqueeze(0)
+        _EYE_DICT[key] = t
+    return t
