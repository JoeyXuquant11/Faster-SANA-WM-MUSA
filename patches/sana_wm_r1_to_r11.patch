+            dw0_3 = fmaf(d0_0, x0_0,          dw0_3); dw1_3 = fmaf(d1_0, x1_0,          dw1_3);
+            db0 += d0_0; db1 += d1_0;
+
+            x0_m3 = x0_m2; x0_m2 = x0_m1; x0_m1 = x0_0; x0_0 = x0_p1; x0_p1 = x0_p2; x0_p2 = x0_p3;
+            x1_m3 = x1_m2; x1_m2 = x1_m1; x1_m1 = x1_0; x1_0 = x1_p1; x1_p1 = x1_p2; x1_p2 = x1_p3;
