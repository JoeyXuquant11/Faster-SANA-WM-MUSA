+                del k_b, v_b
+                W_cam = torch.empty_like(P_cam)
+                rc = lib.launch_gdn_make_W(P_cam.data_ptr(), 0, decay_m.data_ptr(), W_cam.data_ptr(), 0, M, D, st)
