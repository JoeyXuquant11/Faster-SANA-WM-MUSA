+            } else {
+                const __mt_bfloat162* xh = reinterpret_cast<const __mt_bfloat162*>(&xv);
+                #pragma unroll
+                for (int k = 0; k < 4; ++k) {
+                    float a = __low2float(xh[k]), b = __high2float(xh[k]);
+                    v[2*k] = a; v[2*k+1] = b;
+                    sum += a + b; sum2 = fmaf(a, a, fmaf(b, b, sum2));
