+                out_2d = output_tensor.view(world, n)
+                for r in range(world):
+                    out_2d[r].copy_(padded_out[r, :n])
+            if async_op and work is not None:
+                return _AlignedCopyBackWork(work, _copy_back_ag)
+            _copy_back_ag()
