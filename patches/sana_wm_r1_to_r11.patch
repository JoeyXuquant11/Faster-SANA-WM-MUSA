+) {
+    const int bt = blockIdx.x, sp = blockIdx.y, tid = threadIdx.x, C8 = C >> 3;
+    const int n_warps = blockDim.x >> 5;
+    const bool active = (tid < C8);
+    const int c0 = tid << 3;
+    float sh[8], sc1[8], ysum[8];
+    if (active) {
